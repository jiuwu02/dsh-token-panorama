{
  "name": "dsh-token-panorama",
  "version": "1.0.5",
  "type": "module",
  "description": "Token panorama for DSH: totals, cache hit rate, peak/off-peak cost, calendar heatmap, session tree, workspaces, CSV/JSON export, plus context clear/compact actions, prompt optimization, and auto answers for ask_user_question batches.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "token",
    "usage",
    "cost",
    "billing"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/i18n.test.mjs && node test/smoke.test.mjs && node test/scan.test.mjs && node test/stats-reset.test.mjs && node test/segment.test.mjs && node test/truncate.test.mjs && node test/ask.test.mjs && node test/prompts.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiuwu02/dsh-token-panorama.git"
  },
  "bugs": {
    "url": "https://github.com/jiuwu02/dsh-token-panorama/issues"
  },
  "homepage": "https://github.com/jiuwu02/dsh-token-panorama#readme",
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "icon-prompt-optimize.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
